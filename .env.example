# ─────────────────────────────────────────────────────────────────────────────
# Diamond Luxury Real Estate — Backend environment variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
# Port the Express API listens on. The Next.js frontend proxies /api/* here.
PORT=4000
# CORS: comma-separated list of allowed origins, or * for any. Use the frontend URL.
CORS_ORIGIN=http://localhost:3000
# Public URL of the Next.js frontend (used in email links back to the site).
SITE_URL=http://localhost:3000
SITE_NAME=Diamond Luxury Real Estate

# ── MySQL ─────────────────────────────────────────────────────────────────────
DB_HOST=srv629.hstgr.io
DB_PORT=3306
DB_USER=u184056080_diamonduser
DB_PASSWORD=Onion@123321
DB_NAME=u184056080_diamondluxury
DB_POOL_SIZE=10

# ── FTP ───────────────────────────────────────────────────────────────────────
FTP_HOST=ftp.amirhost.in
FTP_PORT=21
FTP_USER=u184056080.diamonduser
FTP_PASSWORD=Onion@123321
# Full path on the FTP server where uploads land
FTP_BASE_DIR=/uploads
# Public base URL that serves those uploaded files (CDN or direct domain)
FTP_PUBLIC_URL=https://luxurydiamond.amirhost.in/uploads

# ── Gmail SMTP ────────────────────────────────────────────────────────────────
# Use an App Password, NOT your Google account password.
# Generate one at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=Diamond Luxury Real Estate <your_gmail_address@gmail.com>
# Where admin notification emails are delivered
ADMIN_EMAIL=info@diamondluxury.ae

# ── JWT ───────────────────────────────────────────────────────────────────────
# Use a long random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=8h

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
